# ==============================================================================
# Relfor Inventory & Donation Allocation System - Environment Variables
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=relfor_db
DB_USER=relfor_user
DB_PASSWORD=relfor_password

# Database Connection URL (for FastAPI / SQLAlchemy)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Application Server Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Security & Authentication (JWT)
# IMPORTANT: Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY=relfor_super_secret_development_jwt_key_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
