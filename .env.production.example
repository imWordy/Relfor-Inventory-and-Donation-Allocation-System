# ==============================================================================
# Relfor Inventory & Donation Allocation System — Production Environment Template
# Copy this file to .env before starting the production services.
# ==============================================================================

# Database Settings
POSTGRES_DB=relfor_db
POSTGRES_USER=relfor_user
POSTGRES_PASSWORD=replace_with_secure_database_password
POSTGRES_PORT=5432

# Backend Settings
PROJECT_NAME="Relfor Inventory & Donation Allocation API"
DATABASE_URL=postgresql+psycopg://relfor_user:replace_with_secure_database_password@localhost:5432/relfor_db
SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Frontend Settings (Vite / React)
VITE_API_BASE_URL=https://api.relfor.org
